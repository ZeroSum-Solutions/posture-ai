{
  "name": "@posture-ai/engine",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-agnostic deterministic posture & movement scoring engine. Pure TS, no DOM/network deps. Shared by the mobile app and the web report portal.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./metrics": "./src/metrics.ts",
    "./thresholds": "./src/thresholds.ts",
    "./geometry": "./src/geometry.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^3.2.1"
  }
}
