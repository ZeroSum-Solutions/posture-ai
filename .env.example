# Supabase (project dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags
# Test-only fixture switch. The full unreviewed catalog is available only when
# BOTH flags are 1; never set either flag in production.
POSTURE_TEST_MODE_ENABLED=0
NEXT_PUBLIC_SHOW_UNREVIEWED_CONTENT=false

# Server-only clinical release activation. Leave both unset until HG-03 has a
# signed licensed-clinician receipt and the exact release is committed to
# content/clinical-review-ledger.json. A missing or mismatched value disables
# recommendations, programs, workouts, and clinical knowledge links.
CLINICAL_CONTENT_RELEASE_ID=
CLINICAL_CONTENT_HG03_RECEIPT_SHA256=

# Optional: canonical site URL for metadata/robots/sitemap
# (defaults to the documented production origin when unset)
NEXT_PUBLIC_SITE_URL=
