# Supabase (project dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags
# Test-only fixture switch. The full unreviewed catalog is available only when
# BOTH flags are 1; never set either flag in production.
POSTURE_TEST_MODE_ENABLED=0
NEXT_PUBLIC_SHOW_UNREVIEWED_CONTENT=false

# The HG-03 clinical-content activation gate was removed on 2026-10-01: the full
# catalog is always served, so no release id or receipt is configured here.

# Optional: canonical site URL for metadata/robots/sitemap
# (defaults to the documented production origin when unset)
NEXT_PUBLIC_SITE_URL=

# Original application prototype operation (server-only, existing practitioner UUIDs).
POSTURE_OPERATION_MODE=governed
POSTURE_PROTOTYPE_PRACTITIONER_IDS=

# Optional live AI for the authenticated workout builder (server-only).
# Without a provider, Build from scan remains available and is labeled separately.
POSTURE_WORKOUT_OPENROUTER_API_KEY=
POSTURE_WORKOUT_OPENROUTER_MODEL=google/gemini-3.8-flash

# Select one approved AI provider; no automatic second paid request.
POSTURE_WORKOUT_AI_PROVIDER=deepseek
POSTURE_WORKOUT_DEEPSEEK_API_KEY=
POSTURE_WORKOUT_DEEPSEEK_MODEL=deepseek-v4-flash
