{
  "name": "posture-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/posture-engine"
  ],
  "scripts": {
    "predev": "node scripts/copy-mediapipe-wasm.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/copy-mediapipe-wasm.mjs",
    "build": "next build",
    "sync:muscle-viewer": "pnpm -C ../muscle-viewer build && rm -rf public/muscle-viewer && cp -R ../muscle-viewer/dist public/muscle-viewer && cp ../muscle-viewer/dist/muscle-ids.json 'app/assessments/[id]/muscleIds.generated.json'",
    "start": "next start",
    "lint": "eslint .",
    "lint:vocab": "vitest run content",
    "test": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "qa:seed": "npx vite-node scripts/qa-seed.ts",
    "golden": "node scripts/golden-report.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.64.2",
    "framer-motion": "^12.12.1",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "supabase": "^2.106.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.1"
  }
}
